@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center mb-4">
    <h1 class="h2">Explorador de contenido aleatorio</h1>
    <p class="text-muted mb-0">Cada sección consulta su propia API pública. Presiona un botón para actualizar solo esa sección.</p>
</div>

<div class="row row-cols-1 row-cols-md-2 g-4">

    <!-- 1. Citas — DummyJSON -->
    <div class="col">
        <section class="card h-100 shadow-sm" aria-labelledby="titulo-cita">
            <div class="card-header bg-primary text-white">
                <h2 id="titulo-cita" class="h5 mb-0">Citas y autores</h2>
            </div>
            <div class="card-body d-flex flex-column">
                <div id="contenido-cita" class="contenido-seccion flex-grow-1" aria-live="polite"></div>
                <button id="boton-cita" type="button" class="btn btn-primary mt-3">Obtener otra cita</button>
            </div>
        </section>
    </div>

    <!-- 2. Perros — Dog CEO -->
    <div class="col">
        <section class="card h-100 shadow-sm" aria-labelledby="titulo-perro">
            <div class="card-header bg-success text-white">
                <h2 id="titulo-perro" class="h5 mb-0">Imágenes de perros</h2>
            </div>
            <div class="card-body d-flex flex-column">
                <div id="contenido-perro" class="contenido-seccion flex-grow-1" aria-live="polite"></div>
                <button id="boton-perro" type="button" class="btn btn-success mt-3">Mostrar otro perro</button>
            </div>
        </section>
    </div>

    <!-- 3. Gatos — CATAAS -->
    <div class="col">
        <section class="card h-100 shadow-sm" aria-labelledby="titulo-gato">
            <div class="card-header bg-warning">
                <h2 id="titulo-gato" class="h5 mb-0">Imágenes de gatos</h2>
            </div>
            <div class="card-body d-flex flex-column">
                <div id="contenido-gato" class="contenido-seccion flex-grow-1" aria-live="polite"></div>
                <button id="boton-gato" type="button" class="btn btn-warning mt-3">Mostrar otro gato</button>
            </div>
        </section>
    </div>

    <!-- 4. Datos curiosos — Useless Facts -->
    <div class="col">
        <section class="card h-100 shadow-sm" aria-labelledby="titulo-dato">
            <div class="card-header bg-info">
                <h2 id="titulo-dato" class="h5 mb-0">Datos curiosos</h2>
            </div>
            <div class="card-body d-flex flex-column">
                <div id="contenido-dato" class="contenido-seccion flex-grow-1" aria-live="polite"></div>
                <button id="boton-dato" type="button" class="btn btn-info mt-3">Mostrar otro dato</button>
            </div>
        </section>
    </div>

</div>

@section Scripts {
    <script src="~/js/explorador.js" asp-append-version="true"></script>
}
